   exp: number;
+  organizationId?: string;
+  tierLevel?: 'free' | 'pro' | 'enterprise';
 }
 
-export function verifyToken(token: string): TokenPayload | null {
-  if (!token) {
-    return null;
+export async function verifyToken(token: string, secretKey: string): Promise<TokenPayload> {
+  if (!token || token.trim() === '') {
+    throw new Error('Authentication token is required');
   }
-  try {
-    // Legacy insecure decoding
-    const decoded = JSON.parse(Buffer.from(token.split('.')[1], 'base64').toString());
-    return decoded as TokenPayload;
-  } catch (e) {
-    return null;
+
+  // Enforce cryptographic HMAC SHA-256 verification
+  const [headerB64, payloadB64, signature] = token.split('.');
+  if (!headerB64 || !payloadB64 || !signature) {
+    throw new Error('Malformed JWT structure');
   }
+
+  const expectedSignature = crypto.createHmac('sha256', secretKey)
+    .update(`${headerB64}.${payloadB64}`)
+    .digest('base64url');
+
+  if (signature !== expectedSignature) {
+    throw new Error('Invalid token cryptographic signature');
+  }
+
+  const payload = JSON.parse(Buffer.from(payloadB64, 'base64url').toString('utf8'));
+  return payload as TokenPayload;
 }
